generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IdentityStatus {
  ACTIVE
  INACTIVE
}

enum RoleStatus {
  ACTIVE
  REVOKED
}

enum FunctionalRole {
  USER
  ADMINISTRATOR
  ANALYST
  TUTOR
  ACADEMY_USER
}

enum MembershipStatus {
  ACTIVE
  ENDED
}

enum ChangeOutcome {
  APPLIED
  DENIED
  FAILED
}

enum CredentialStatus {
  ACTIVE
  DISABLED
}

enum TemporaryCredentialStatus {
  ISSUED
  CONSUMED
  INVALIDATED
  SUPERSEDED
  EXPIRED
}

enum AuthenticationSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum RefreshTokenStatus {
  ISSUED
  CONSUMED
  REVOKED
  EXPIRED
}

enum AuthenticationSecurityEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGIN_THROTTLED
  TEMPORARY_CREDENTIAL_PROVISIONED
  TEMPORARY_CREDENTIAL_REISSUED
  TEMPORARY_CREDENTIAL_REPLACED
  REFRESH_ROTATED
  REFRESH_REUSE_DETECTED
  SESSION_REVOKED
  SESSIONS_REVOKED
  INITIALIZATION_SUCCEEDED
  INITIALIZATION_DENIED
  RECOVERY_SUCCEEDED
  RECOVERY_DENIED
}

enum PassportOrigin {
  PARTICULAR
  TUTOR
  ACADEMY
}

enum PassportResponsibilityKind {
  SELF
  LEGAL_REPRESENTATIVE
  ACADEMY
}

enum RepresentativeConfirmationStatus {
  PENDING
  CONSUMED
  EXPIRED
  REVOKED
}

enum PassportLifecycleState {
  DRAFT
  IN_REVIEW
  RETURNED_FOR_CORRECTION
  APPROVED
  ACTIVE
}

enum PassportEnrichmentStatus {
  COMPLETE
  AWAITING_ANALYST_ENRICHMENT
}

enum DominantFoot {
  LEFT
  RIGHT
  BOTH
  UNDECLARED
}

enum PassportPossibleDuplicateStatus {
  UNRESOLVED
  RESOLVED
}

enum PassportDuplicateResolution {
  PENDING_REVIEW
  DIFFERENT_PLAYERS
  CORRECTABLE
  CONFIRMED_EXISTING_PLAYER
}

enum PassportLifecycleAction {
  CREATED
  INITIAL_TUTOR_RESPONSIBILITY_ESTABLISHED
  EDITED
  SUBMITTED
  RETURNED_FOR_CORRECTION
  POSSIBLE_DUPLICATE_RESOLVED
  APPROVED
  ACTIVATED
}

enum PassportLifecycleOutcome {
  APPLIED
  DENIED
  FAILED
}

enum RegistrationRequestType {
  PERSONAL_ADULT
  REPRESENTED_MINOR
  FORMAL_ACADEMY
  NATURAL_PERSON_ACADEMY
  ADDITIONAL_ACADEMY_ACCOUNT
  ACADEMY_ADULT_PLAYER
  ACADEMY_MINOR_PLAYER
}

enum RegistrationRequestStatus {
  DRAFT
  SUBMITTED
  REQUIRES_CORRECTION
  APPROVED
  REJECTED
}

enum RegistrationApplicantAccessStatus {
  PENDING_ONBOARDING
  APPROVED
  REJECTED
}

enum EvidenceStatus {
  QUARANTINED
  SCANNING
  CLEAN
  REJECTED
  REPLACED
  DELETION_PENDING
  DELETED
}

enum ApprovalExecutionStatus {
  NONE
  PREPARED
  DELETING_EVIDENCE
  READY_TO_FINALIZE
  FINALIZED
  RECOVERY_REQUIRED
}

enum EvidenceDeletionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  RECOVERY_REQUIRED
}

enum RegistrationEvidenceCategory {
  IDENTITY_FRONT
  IDENTITY_BACK
  MINOR_CIVIL_IDENTITY
  REPRESENTATION_AUTHORITY
  RUT
  EXISTENCE_CERTIFICATE
  OPERATION_PROOF
  RESPONSIBLE_AUTHORITY
  ADULT_AUTHORIZATION
  ACADEMY_ACCOUNT_AUTHORIZATION
}

enum RegistrationConsentType {
  PRIVACY
  TRUTHFULNESS
  SELF_ACTION
  REPRESENTATION
  MINOR_TREATMENT
  ACADEMY_PRESENTATION
}

enum RegistrationRelationshipKind {
  MOTHER
  FATHER
  LEGAL_GUARDIAN
}

enum RegistrationProofOfOperationCategory {
  RUT
  MUNICIPAL_OR_SPORT_CERTIFICATION
  PLACE_USE_AUTHORIZATION
  OPERATION_CONTRACT_OR_REGISTER
  OTHER_CONTROLLED
}

enum RegistrationReviewDecisionKind {
  CORRECTION_REQUESTED
  APPROVED
  REJECTED
}

enum RegistrationDuplicateSignalStatus {
  OPEN
  DISTINCT
  CONFIRMED_CONFLICT
}

enum RegistrationRequestEventOutcome {
  APPLIED
  DENIED
  FAILED
}

enum RegistrationAdminReviewStage {
  OPENED
  REVIEWED
}

enum PassportCustodyAction {
  ASSIGNED
  CHANGED
  REMOVED
}

enum MatchAllowanceCadence {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

model Identity {
  id                                    String                                  @id @default(uuid()) @db.Uuid
  status                                IdentityStatus                          @default(ACTIVE)
  createdAt                             DateTime                                @default(now())
  updatedAt                             DateTime                                @updatedAt
  deactivatedAt                         DateTime?
  roleAssignments                       RoleAssignment[]                        @relation("roleIdentity")
  assignedRoles                         RoleAssignment[]                        @relation("roleAssignedBy")
  memberships                           AcademyMembership[]                     @relation("membershipIdentity")
  assignedMemberships                   AcademyMembership[]                     @relation("membershipAssignedBy")
  actorChanges                          AuthorizationChangeRecord[]             @relation("changeActor")
  targetChanges                         AuthorizationChangeRecord[]             @relation("changeTarget")
  authenticationCredential              AuthenticationCredential?
  temporaryCredentials                  TemporaryCredential[]                   @relation("temporaryCredentialIdentity")
  issuedTemporaryCredentials            TemporaryCredential[]                   @relation("temporaryCredentialIssuer")
  authenticationSessions                AuthenticationSession[]
  authenticationAttempts                AuthenticationAttempt[]
  authenticationSecurityEvents          AuthenticationSecurityEvent[]           @relation("authenticationSecurityEventIdentity")
  actedAuthenticationSecurityEvents     AuthenticationSecurityEvent[]           @relation("authenticationSecurityEventActor")
  createdPassports                      PlayerPassport[]                        @relation("passportCreator")
  passportInitialResponsibilities       InitialTutorResponsibility[]            @relation("passportResponsibleTutor")
  passportResponsibilities              PassportResponsibility[]                @relation("passportResponsibilityIdentity")
  representativeConfirmations           RepresentativeConfirmation[]            @relation("representativeConfirmationIdentity")
  reconciliationAudits                  HistoricalTutorReconciliationAudit[]    @relation("reconciliationAuditActor")
  passportReviewReturns                 PassportReviewReturn[]                  @relation("passportReturningAnalyst")
  passportDuplicateResolutions          PassportPossibleDuplicateSignal[]       @relation("passportSignalResolver")
  passportLifecycleEvents               PassportLifecycleEvent[]                @relation("passportEventActor")
  ownedRegistrationRequests             RegistrationRequest[]                   @relation("registrationRequestOwner")
  registrationApplicantAccesses         RegistrationApplicantAccess[]           @relation("registrationApplicantAccessIdentity")
  registrationApplicants                RegistrationRequestApplicant[]          @relation("registrationApplicantIdentity")
  registrationRepresentatives           RegistrationRequestRepresentative[]     @relation("registrationRepresentativeIdentity")
  registrationEvents                    RegistrationRequestEvent[]              @relation("registrationEventActor")
  registrationCorrections               RegistrationCorrectionRequest[]         @relation("registrationCorrectionAdministrator")
  registrationReviewDecisions           RegistrationReviewDecision[]            @relation("registrationDecisionAdministrator")
  registrationDossierConfirmations      RegistrationManualDossierConfirmation[] @relation("registrationDossierAdministrator")
  registrationDuplicateResolutions      RegistrationPrivateDuplicateSignal[]    @relation("registrationDuplicateResolver")
  registrationEvidenceAccessAudits      RegistrationEvidenceAccessAudit[]       @relation("registrationEvidenceAccessActor")
  registrationRequestIdempotencyRecords RegistrationRequestIdempotencyRecord[]  @relation("registrationIdempotencyActor")
  analystOperationalProfile             AnalystOperationalProfile?
  startedRegistrationReviewProgress     RegistrationAdminReviewProgress[]       @relation("registrationReviewProgressStartedBy")
  updatedRegistrationReviewProgress     RegistrationAdminReviewProgress[]       @relation("registrationReviewProgressUpdatedBy")
  currentPassportCustodies              PassportCustody[]                       @relation("passportCurrentAnalyst")
  administeredPassportCustodyEvents     PassportCustodyEvent[]                  @relation("passportCustodyAdministrator")
  priorPassportCustodyEvents            PassportCustodyEvent[]                  @relation("passportCustodyPreviousAnalyst")
  nextPassportCustodyEvents             PassportCustodyEvent[]                  @relation("passportCustodyNextAnalyst")
  confirmedMatchAllowanceRevisions      PassportMatchAllowanceRevision[]        @relation("matchAllowanceRevisionActor")
}

model RoleAssignment {
  id                   String         @id @default(uuid()) @db.Uuid
  identityId           String         @db.Uuid
  role                 FunctionalRole
  status               RoleStatus     @default(ACTIVE)
  assignedAt           DateTime       @default(now())
  revokedAt            DateTime?
  assignedByIdentityId String         @db.Uuid
  identity             Identity       @relation("roleIdentity", fields: [identityId], references: [id], onDelete: Restrict)
  assignedBy           Identity       @relation("roleAssignedBy", fields: [assignedByIdentityId], references: [id], onDelete: Restrict)

  @@index([identityId, status])
}

model Academy {
  id                       String                   @id @default(uuid()) @db.Uuid
  createdAt                DateTime                 @default(now())
  displayName              String?
  memberships              AcademyMembership[]
  passports                PlayerPassport[]         @relation("passportOriginAcademy")
  passportResponsibilities PassportResponsibility[]
  registrationRequests     RegistrationRequest[]    @relation("registrationRequestAcademy")
}

model AcademyMembership {
  id                   String           @id @default(uuid()) @db.Uuid
  identityId           String           @db.Uuid
  academyId            String           @db.Uuid
  status               MembershipStatus @default(ACTIVE)
  startedAt            DateTime         @default(now())
  endedAt              DateTime?
  assignedByIdentityId String           @db.Uuid
  identity             Identity         @relation("membershipIdentity", fields: [identityId], references: [id], onDelete: Restrict)
  academy              Academy          @relation(fields: [academyId], references: [id], onDelete: Restrict)
  assignedBy           Identity         @relation("membershipAssignedBy", fields: [assignedByIdentityId], references: [id], onDelete: Restrict)

  @@index([academyId, status])
  @@index([identityId, startedAt])
}

model AuthorizationChangeRecord {
  id               String        @id @default(uuid()) @db.Uuid
  actorIdentityId  String        @db.Uuid
  targetIdentityId String        @db.Uuid
  operation        String
  priorState       Json
  resultingState   Json
  outcome          ChangeOutcome
  reasonCategory   String
  policyVersion    String
  createdAt        DateTime      @default(now())
  actor            Identity      @relation("changeActor", fields: [actorIdentityId], references: [id], onDelete: Restrict)
  target           Identity      @relation("changeTarget", fields: [targetIdentityId], references: [id], onDelete: Restrict)

  @@index([targetIdentityId, createdAt])
}

model AuthenticationCredential {
  id              String           @id @default(uuid()) @db.Uuid
  identityId      String           @unique @db.Uuid
  normalizedEmail String           @unique
  passwordHash    String
  status          CredentialStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  activatedAt     DateTime?
  disabledAt      DateTime?
  identity        Identity         @relation(fields: [identityId], references: [id], onDelete: Restrict)
}

model TemporaryCredential {
  id                 String                    @id @default(uuid()) @db.Uuid
  identityId         String                    @db.Uuid
  issuedByIdentityId String?                   @db.Uuid
  secretHash         String
  normalizedEmail    String
  status             TemporaryCredentialStatus @default(ISSUED)
  issuedAt           DateTime                  @default(now())
  expiresAt          DateTime
  consumedAt         DateTime?
  invalidatedAt      DateTime?
  supersededAt       DateTime?
  identity           Identity                  @relation("temporaryCredentialIdentity", fields: [identityId], references: [id], onDelete: Restrict)
  issuedBy           Identity?                 @relation("temporaryCredentialIssuer", fields: [issuedByIdentityId], references: [id], onDelete: Restrict)

  @@index([identityId, expiresAt])
}

model AuthenticationSession {
  id               String                        @id @default(uuid()) @db.Uuid
  identityId       String                        @db.Uuid
  familyId         String                        @db.Uuid
  status           AuthenticationSessionStatus   @default(ACTIVE)
  createdAt        DateTime                      @default(now())
  lastUsedAt       DateTime                      @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revocationReason String?
  identity         Identity                      @relation(fields: [identityId], references: [id], onDelete: Restrict)
  refreshTokens    RefreshTokenHistory[]
  securityEvents   AuthenticationSecurityEvent[]

  @@index([identityId, status, expiresAt])
  @@index([familyId, status])
}

model RefreshTokenHistory {
  id            String                @id @default(uuid()) @db.Uuid
  sessionId     String                @db.Uuid
  digest        String                @unique
  status        RefreshTokenStatus    @default(ISSUED)
  issuedAt      DateTime              @default(now())
  expiresAt     DateTime
  consumedAt    DateTime?
  revokedAt     DateTime?
  replacedAt    DateTime?
  predecessorId String?               @unique @db.Uuid
  session       AuthenticationSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  predecessor   RefreshTokenHistory?  @relation("refreshTokenRotation", fields: [predecessorId], references: [id], onDelete: Restrict)
  successor     RefreshTokenHistory?  @relation("refreshTokenRotation")

  @@index([sessionId, status, expiresAt])
}

model AuthenticationAttempt {
  id                          String    @id @default(uuid()) @db.Uuid
  identityId                  String?   @db.Uuid
  normalizedIdentityKeyDigest String
  sourceAddressKeyDigest      String
  failureCount                Int       @default(0)
  windowStartedAt             DateTime  @default(now())
  windowEndsAt                DateTime
  clearedAt                   DateTime?
  expiresAt                   DateTime?
  identity                    Identity? @relation(fields: [identityId], references: [id], onDelete: Restrict)

  @@index([normalizedIdentityKeyDigest, sourceAddressKeyDigest, windowEndsAt])
  @@index([identityId, windowEndsAt])
}

model AuthenticationSecurityEvent {
  id              String                          @id @default(uuid()) @db.Uuid
  type            AuthenticationSecurityEventType
  outcome         ChangeOutcome
  identityId      String?                         @db.Uuid
  actorIdentityId String?                         @db.Uuid
  sessionId       String?                         @db.Uuid
  reasonCategory  String?
  details         Json
  createdAt       DateTime                        @default(now())
  identity        Identity?                       @relation("authenticationSecurityEventIdentity", fields: [identityId], references: [id], onDelete: Restrict)
  actorIdentity   Identity?                       @relation("authenticationSecurityEventActor", fields: [actorIdentityId], references: [id], onDelete: Restrict)
  session         AuthenticationSession?          @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([identityId, createdAt])
  @@index([actorIdentityId, createdAt])
  @@index([sessionId, createdAt])
}

model Player {
  id                         String                      @id @default(uuid()) @db.Uuid
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  passport                   PlayerPassport?
  privateIdentity            PlayerPrivateIdentity?
  initialTutorResponsibility InitialTutorResponsibility?
  registrationRequestPlayers RegistrationRequestPlayer[]
}

model PlayerPrivateIdentity {
  id                      String   @id @default(uuid()) @db.Uuid
  playerId                String   @unique @db.Uuid
  encryptedLegalName      String
  encryptedDateOfBirth    String
  encryptedDocumentType   String
  encryptedDocumentNumber String
  documentFingerprint     String   @unique
  nameDobFingerprint      String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  player                  Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@index([nameDobFingerprint])
}

model PlayerPassport {
  id                       String                            @id @default(uuid()) @db.Uuid
  playerId                 String                            @unique @db.Uuid
  state                    PassportLifecycleState            @default(DRAFT)
  enrichmentStatus         PassportEnrichmentStatus          @default(COMPLETE)
  originKind               PassportOrigin
  position                 String
  ageCategory              String
  city                     String
  country                  String
  dominantFoot             DominantFoot
  createdByIdentityId      String                            @db.Uuid
  originAcademyId          String?                           @db.Uuid
  version                  Int                               @default(0)
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt
  player                   Player                            @relation(fields: [playerId], references: [id], onDelete: Restrict)
  creator                  Identity                          @relation("passportCreator", fields: [createdByIdentityId], references: [id], onDelete: Restrict)
  originAcademy            Academy?                          @relation("passportOriginAcademy", fields: [originAcademyId], references: [id], onDelete: Restrict)
  responsibilities         PassportResponsibility[]
  reviewReturns            PassportReviewReturn[]
  possibleDuplicateSignals PassportPossibleDuplicateSignal[]
  lifecycleEvents          PassportLifecycleEvent[]
  custody                  PassportCustody?
  custodyEvents            PassportCustodyEvent[]
  matchAllowance           PassportMatchAllowance?

  @@index([createdByIdentityId, state])
  @@index([originAcademyId])
  @@index([state])
}

model PassportResponsibility {
  id         String                     @id @default(uuid()) @db.Uuid
  passportId String                     @db.Uuid
  identityId String?                    @db.Uuid
  academyId  String?                    @db.Uuid
  kind       PassportResponsibilityKind
  createdAt  DateTime                   @default(now())
  passport   PlayerPassport             @relation(fields: [passportId], references: [id], onDelete: Restrict)
  identity   Identity?                  @relation("passportResponsibilityIdentity", fields: [identityId], references: [id], onDelete: Restrict)
  academy    Academy?                   @relation(fields: [academyId], references: [id], onDelete: Restrict)

  @@unique([passportId, kind, identityId])
  @@index([identityId, kind])
  @@index([academyId, kind])
}

model RepresentativeConfirmation {
  id                       String                           @id @default(uuid()) @db.Uuid
  passportId               String?                          @db.Uuid
  representativeIdentityId String                           @db.Uuid
  encryptedLegalName       String
  encryptedDocumentType    String
  encryptedDocumentNumber  String
  encryptedRelationship    String?
  documentFingerprint      String
  playerDocumentBinding    String
  status                   RepresentativeConfirmationStatus @default(PENDING)
  expiresAt                DateTime
  consumedAt               DateTime?
  createdAt                DateTime                         @default(now())
  representative           Identity                         @relation("representativeConfirmationIdentity", fields: [representativeIdentityId], references: [id], onDelete: Restrict)

  @@index([representativeIdentityId, status, expiresAt])
  @@index([playerDocumentBinding, status])
}

model HistoricalTutorReconciliationAudit {
  id                     String   @id @default(uuid()) @db.Uuid
  actorIdentityId        String   @db.Uuid
  legacyResponsibilityId String?
  outcome                String
  reasonCategory         String
  createdAt              DateTime @default(now())
  actor                  Identity @relation("reconciliationAuditActor", fields: [actorIdentityId], references: [id], onDelete: Restrict)

  @@index([actorIdentityId, createdAt])
}

model InitialTutorResponsibility {
  id              String   @id @default(uuid()) @db.Uuid
  playerId        String   @unique @db.Uuid
  tutorIdentityId String   @db.Uuid
  createdAt       DateTime @default(now())
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)
  tutor           Identity @relation("passportResponsibleTutor", fields: [tutorIdentityId], references: [id], onDelete: Restrict)

  @@index([tutorIdentityId])
}

model PassportReviewReturn {
  id                String         @id @default(uuid()) @db.Uuid
  passportId        String         @db.Uuid
  analystIdentityId String         @db.Uuid
  reason            String
  createdAt         DateTime       @default(now())
  passport          PlayerPassport @relation(fields: [passportId], references: [id], onDelete: Restrict)
  analyst           Identity       @relation("passportReturningAnalyst", fields: [analystIdentityId], references: [id], onDelete: Restrict)

  @@index([passportId, createdAt])
}

model PassportPossibleDuplicateSignal {
  id                   String                          @id @default(uuid()) @db.Uuid
  passportId           String                          @db.Uuid
  status               PassportPossibleDuplicateStatus @default(UNRESOLVED)
  resolution           PassportDuplicateResolution     @default(PENDING_REVIEW)
  resolvedByIdentityId String?                         @db.Uuid
  resolvedAt           DateTime?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
  passport             PlayerPassport                  @relation(fields: [passportId], references: [id], onDelete: Restrict)
  resolvedBy           Identity?                       @relation("passportSignalResolver", fields: [resolvedByIdentityId], references: [id], onDelete: Restrict)

  @@index([passportId, status])
}

model PassportLifecycleEvent {
  id              String                   @id @default(uuid()) @db.Uuid
  passportId      String                   @db.Uuid
  action          PassportLifecycleAction
  outcome         PassportLifecycleOutcome
  actorIdentityId String                   @db.Uuid
  priorState      PassportLifecycleState?
  resultingState  PassportLifecycleState?
  details         Json?
  createdAt       DateTime                 @default(now())
  passport        PlayerPassport           @relation(fields: [passportId], references: [id], onDelete: Restrict)
  actor           Identity                 @relation("passportEventActor", fields: [actorIdentityId], references: [id], onDelete: Restrict)

  @@index([passportId, createdAt])
  @@index([actorIdentityId, createdAt])
}

model RegistrationRequest {
  id                             String                                  @id @default(uuid()) @db.Uuid
  type                           RegistrationRequestType
  status                         RegistrationRequestStatus               @default(DRAFT)
  ownerIdentityId                String?                                 @db.Uuid
  academyContextId               String?                                 @db.Uuid
  version                        Int                                     @default(0)
  submittedAt                    DateTime?
  decidedAt                      DateTime?
  approvalExecutionStatus        ApprovalExecutionStatus                 @default(NONE)
  latestSafeReason               String?
  createdAt                      DateTime                                @default(now())
  updatedAt                      DateTime                                @updatedAt
  owner                          Identity?                               @relation("registrationRequestOwner", fields: [ownerIdentityId], references: [id], onDelete: Restrict)
  academyContext                 Academy?                                @relation("registrationRequestAcademy", fields: [academyContextId], references: [id], onDelete: Restrict)
  applicantAccess                RegistrationApplicantAccess?
  applicants                     RegistrationRequestApplicant[]
  players                        RegistrationRequestPlayer[]
  representatives                RegistrationRequestRepresentative[]
  personalAdultDetail            PersonalAdultRequestDetail?
  representedMinorDetail         RepresentedMinorRequestDetail?
  formalAcademyDetail            FormalAcademyRequestDetail?
  naturalPersonAcademyDetail     NaturalPersonAcademyRequestDetail?
  additionalAcademyAccountDetail AdditionalAcademyAccountRequestDetail?
  academyAdultPlayerDetail       AcademyAdultPlayerRequestDetail?
  academyMinorPlayerDetail       AcademyMinorPlayerRequestDetail?
  evidenceItems                  RegistrationEvidenceItem[]
  consents                       RegistrationConsentRecord[]
  corrections                    RegistrationCorrectionRequest[]
  decisions                      RegistrationReviewDecision[]
  dossierConfirmations           RegistrationManualDossierConfirmation[]
  approvalExecutions             RegistrationApprovalExecution[]
  deletionRecords                RegistrationEvidenceDeletionRecord[]
  events                         RegistrationRequestEvent[]
  duplicateSignals               RegistrationPrivateDuplicateSignal[]
  evidenceAccessAudits           RegistrationEvidenceAccessAudit[]
  idempotencyRecords             RegistrationRequestIdempotencyRecord[]
  exactIdentifierClaims          RegistrationExactIdentifierClaim[]
  adminReviewProgress            RegistrationAdminReviewProgress?

  @@index([ownerIdentityId, status, updatedAt])
  @@index([academyContextId, status, updatedAt])
  @@index([type, status, submittedAt])
}

model RegistrationExactIdentifierClaim {
  id        String              @id @default(uuid()) @db.Uuid
  claimKey  String              @unique
  field     String
  requestId String              @db.Uuid
  createdAt DateTime            @default(now())
  request   RegistrationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model RegistrationApplicantAccess {
  id         String                            @id @default(uuid()) @db.Uuid
  requestId  String                            @unique @db.Uuid
  identityId String                            @db.Uuid
  status     RegistrationApplicantAccessStatus @default(PENDING_ONBOARDING)
  createdAt  DateTime                          @default(now())
  updatedAt  DateTime                          @updatedAt
  request    RegistrationRequest               @relation(fields: [requestId], references: [id], onDelete: Restrict)
  identity   Identity                          @relation("registrationApplicantAccessIdentity", fields: [identityId], references: [id], onDelete: Restrict)

  @@index([identityId, status])
}

model RegistrationRequestApplicant {
  id                          String                                  @id @default(uuid()) @db.Uuid
  requestId                   String                                  @db.Uuid
  identityId                  String?                                 @db.Uuid
  encryptedLegalName          String
  encryptedDateOfBirth        String
  encryptedDocumentType       String
  encryptedDocumentNumber     String
  documentFingerprint         String
  nameDobFingerprint          String
  encryptedEmail              String?
  emailFingerprint            String?
  encryptedPhone              String?
  phoneFingerprint            String?
  derivedAdult                Boolean
  createdAt                   DateTime                                @default(now())
  updatedAt                   DateTime                                @updatedAt
  request                     RegistrationRequest                     @relation(fields: [requestId], references: [id], onDelete: Restrict)
  identity                    Identity?                               @relation("registrationApplicantIdentity", fields: [identityId], references: [id], onDelete: Restrict)
  personalAdultDetails        PersonalAdultRequestDetail[]            @relation("personalAdultApplicant")
  representedMinorDetails     RepresentedMinorRequestDetail[]         @relation("representedMinorApplicant")
  formalAcademyDetails        FormalAcademyRequestDetail[]            @relation("formalAcademyResponsible")
  naturalPersonAcademyDetails NaturalPersonAcademyRequestDetail[]     @relation("naturalAcademyResponsible")
  additionalAccountDetails    AdditionalAcademyAccountRequestDetail[] @relation("additionalAccountApplicant")

  @@unique([requestId, documentFingerprint])
  @@index([requestId])
  @@index([nameDobFingerprint])
  @@index([emailFingerprint])
}

model RegistrationRequestPlayer {
  id                        String                            @id @default(uuid()) @db.Uuid
  requestId                 String                            @db.Uuid
  linkedPlayerId            String?                           @db.Uuid
  encryptedLegalName        String
  encryptedDateOfBirth      String
  encryptedDocumentType     String
  encryptedDocumentNumber   String
  documentFingerprint       String
  nameDobFingerprint        String
  encryptedCountry          String
  encryptedCity             String
  derivedAdult              Boolean
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt
  request                   RegistrationRequest               @relation(fields: [requestId], references: [id], onDelete: Restrict)
