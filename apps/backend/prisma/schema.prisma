  id                         String                 @id @default(uuid()) @db.Uuid
  allowanceId                String                 @db.Uuid
  sequence                   Int
  idempotencyKey             String                 @db.Uuid
  expectedVersion            Int
  cadence                    MatchAllowanceCadence
  matchLimit                 BigInt                 @db.BigInt
  effectiveOn                DateTime               @db.Date
  previousCadence            MatchAllowanceCadence?
  previousMatchLimit         BigInt?                @db.BigInt
  previousEffectiveOn        DateTime?              @db.Date
