  @@unique([allowanceId, sequence])
  @@unique([allowanceId, idempotencyKey])
  @@index([allowanceId, effectiveOn, sequence], map: "AllowanceRevision_effective_idx")
  @@index([confirmedByIdentityId, confirmedAt], map: "AllowanceRevision_actor_confirmedAt_idx")
}
