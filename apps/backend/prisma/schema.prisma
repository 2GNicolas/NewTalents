generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IdentityStatus {
  ACTIVE
  INACTIVE
}

enum RoleStatus {
  ACTIVE
  REVOKED
}

enum FunctionalRole {
  USER
  ADMINISTRATOR
  ANALYST
  TUTOR
  ACADEMY_USER
}

enum MembershipStatus {
  ACTIVE
  ENDED
}

enum ChangeOutcome {
  APPLIED
  DENIED
  FAILED
}

enum CredentialStatus {
  ACTIVE
  DISABLED
}

enum TemporaryCredentialStatus {
  ISSUED
  CONSUMED
  INVALIDATED
  SUPERSEDED
  EXPIRED
}

enum AuthenticationSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum RefreshTokenStatus {
  ISSUED
  CONSUMED
  REVOKED
  EXPIRED
}

enum AuthenticationSecurityEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGIN_THROTTLED
  TEMPORARY_CREDENTIAL_PROVISIONED
  TEMPORARY_CREDENTIAL_REISSUED
  TEMPORARY_CREDENTIAL_REPLACED
  REFRESH_ROTATED
  REFRESH_REUSE_DETECTED
  SESSION_REVOKED
  SESSIONS_REVOKED
  INITIALIZATION_SUCCEEDED
  INITIALIZATION_DENIED
  RECOVERY_SUCCEEDED
  RECOVERY_DENIED
}

enum PassportOrigin {
  PARTICULAR
  TUTOR
  ACADEMY
}

enum PassportResponsibilityKind {
  SELF
  LEGAL_REPRESENTATIVE
  ACADEMY
}

enum RepresentativeConfirmationStatus {
  PENDING
  CONSUMED
  EXPIRED
  REVOKED
}

enum PassportLifecycleState {
  DRAFT
  IN_REVIEW
  RETURNED_FOR_CORRECTION
  APPROVED
  ACTIVE
}

enum DominantFoot {
  LEFT
  RIGHT
  BOTH
  UNDECLARED
}

enum PassportPossibleDuplicateStatus {
  UNRESOLVED
  RESOLVED
}

enum PassportDuplicateResolution {
  PENDING_REVIEW
  DIFFERENT_PLAYERS
  CORRECTABLE
  CONFIRMED_EXISTING_PLAYER
}

enum PassportLifecycleAction {
  CREATED
  INITIAL_TUTOR_RESPONSIBILITY_ESTABLISHED
  EDITED
  SUBMITTED
  RETURNED_FOR_CORRECTION
  POSSIBLE_DUPLICATE_RESOLVED
  APPROVED
  ACTIVATED
}

enum PassportLifecycleOutcome {
  APPLIED
  DENIED
  FAILED
}

model Identity {
  id String @id @default(uuid()) @db.Uuid
  status IdentityStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deactivatedAt DateTime?
  roleAssignments RoleAssignment[] @relation("roleIdentity")
  assignedRoles RoleAssignment[] @relation("roleAssignedBy")
  memberships AcademyMembership[] @relation("membershipIdentity")
  assignedMemberships AcademyMembership[] @relation("membershipAssignedBy")
  actorChanges AuthorizationChangeRecord[] @relation("changeActor")
  targetChanges AuthorizationChangeRecord[] @relation("changeTarget")
  authenticationCredential AuthenticationCredential?
  temporaryCredentials TemporaryCredential[] @relation("temporaryCredentialIdentity")
  issuedTemporaryCredentials TemporaryCredential[] @relation("temporaryCredentialIssuer")
  authenticationSessions AuthenticationSession[]
  authenticationAttempts AuthenticationAttempt[]
  authenticationSecurityEvents AuthenticationSecurityEvent[] @relation("authenticationSecurityEventIdentity")
  actedAuthenticationSecurityEvents AuthenticationSecurityEvent[] @relation("authenticationSecurityEventActor")
  createdPassports PlayerPassport[] @relation("passportCreator")
  passportInitialResponsibilities InitialTutorResponsibility[] @relation("passportResponsibleTutor")
  passportResponsibilities PassportResponsibility[] @relation("passportResponsibilityIdentity")
  representativeConfirmations RepresentativeConfirmation[] @relation("representativeConfirmationIdentity")
  reconciliationAudits HistoricalTutorReconciliationAudit[] @relation("reconciliationAuditActor")
  passportReviewReturns PassportReviewReturn[] @relation("passportReturningAnalyst")
  passportDuplicateResolutions PassportPossibleDuplicateSignal[] @relation("passportSignalResolver")
  passportLifecycleEvents PassportLifecycleEvent[] @relation("passportEventActor")
}

model RoleAssignment {
  id String @id @default(uuid()) @db.Uuid
  identityId String @db.Uuid
  role FunctionalRole
  status RoleStatus @default(ACTIVE)
  assignedAt DateTime @default(now())
  revokedAt DateTime?
  assignedByIdentityId String @db.Uuid
  identity Identity @relation("roleIdentity", fields: [identityId], references: [id], onDelete: Restrict)
  assignedBy Identity @relation("roleAssignedBy", fields: [assignedByIdentityId], references: [id], onDelete: Restrict)
  @@index([identityId, status])
}

model Academy {
  id String @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  displayName String?
  memberships AcademyMembership[]
  passports PlayerPassport[] @relation("passportOriginAcademy")
  passportResponsibilities PassportResponsibility[]
}

model AcademyMembership {
  id String @id @default(uuid()) @db.Uuid
  identityId String @db.Uuid
  academyId String @db.Uuid
  status MembershipStatus @default(ACTIVE)
  startedAt DateTime @default(now())
  endedAt DateTime?
  assignedByIdentityId String @db.Uuid
  identity Identity @relation("membershipIdentity", fields: [identityId], references: [id], onDelete: Restrict)
  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)
  assignedBy Identity @relation("membershipAssignedBy", fields: [assignedByIdentityId], references: [id], onDelete: Restrict)
  @@index([academyId, status])
  @@index([identityId, startedAt])
}

model AuthorizationChangeRecord {
  id String @id @default(uuid()) @db.Uuid
  actorIdentityId String @db.Uuid
  targetIdentityId String @db.Uuid
  operation String
  priorState Json
  resultingState Json
  outcome ChangeOutcome
  reasonCategory String
  policyVersion String
  createdAt DateTime @default(now())
  actor Identity @relation("changeActor", fields: [actorIdentityId], references: [id], onDelete: Restrict)
  target Identity @relation("changeTarget", fields: [targetIdentityId], references: [id], onDelete: Restrict)
  @@index([targetIdentityId, createdAt])
}

model AuthenticationCredential {
  id String @id @default(uuid()) @db.Uuid
  identityId String @unique @db.Uuid
  normalizedEmail String @unique
  passwordHash String
  status CredentialStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  activatedAt DateTime?
  disabledAt DateTime?
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Restrict)
}

model TemporaryCredential {
  id String @id @default(uuid()) @db.Uuid
  identityId String @db.Uuid
  issuedByIdentityId String? @db.Uuid
  secretHash String
  normalizedEmail String
  status TemporaryCredentialStatus @default(ISSUED)
  issuedAt DateTime @default(now())
  expiresAt DateTime
  consumedAt DateTime?
  invalidatedAt DateTime?
  supersededAt DateTime?
  identity Identity @relation("temporaryCredentialIdentity", fields: [identityId], references: [id], onDelete: Restrict)
  issuedBy Identity? @relation("temporaryCredentialIssuer", fields: [issuedByIdentityId], references: [id], onDelete: Restrict)
  @@index([identityId, expiresAt])
}

model AuthenticationSession {
  id String @id @default(uuid()) @db.Uuid
  identityId String @db.Uuid
  familyId String @db.Uuid
  status AuthenticationSessionStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  revocationReason String?
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  refreshTokens RefreshTokenHistory[]
  securityEvents AuthenticationSecurityEvent[]
  @@index([identityId, status, expiresAt])
  @@index([familyId, status])
}

model RefreshTokenHistory {
  id String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid
  digest String @unique
  status RefreshTokenStatus @default(ISSUED)
  issuedAt DateTime @default(now())
  expiresAt DateTime
  consumedAt DateTime?
  revokedAt DateTime?
  replacedAt DateTime?
  predecessorId String? @unique @db.Uuid
  session AuthenticationSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  predecessor RefreshTokenHistory? @relation("refreshTokenRotation", fields: [predecessorId], references: [id], onDelete: Restrict)
  successor RefreshTokenHistory? @relation("refreshTokenRotation")
  @@index([sessionId, status, expiresAt])
}

model AuthenticationAttempt {
  id String @id @default(uuid()) @db.Uuid
  identityId String? @db.Uuid
  normalizedIdentityKeyDigest String
  sourceAddressKeyDigest String
  failureCount Int @default(0)
  windowStartedAt DateTime @default(now())
  windowEndsAt DateTime
  clearedAt DateTime?
  expiresAt DateTime?
  identity Identity? @relation(fields: [identityId], references: [id], onDelete: Restrict)
  @@index([normalizedIdentityKeyDigest, sourceAddressKeyDigest, windowEndsAt])
  @@index([identityId, windowEndsAt])
}

model AuthenticationSecurityEvent {
  id String @id @default(uuid()) @db.Uuid
  type AuthenticationSecurityEventType
  outcome ChangeOutcome
  identityId String? @db.Uuid
  actorIdentityId String? @db.Uuid
  sessionId String? @db.Uuid
  reasonCategory String?
  details Json
  createdAt DateTime @default(now())
  identity Identity? @relation("authenticationSecurityEventIdentity", fields: [identityId], references: [id], onDelete: Restrict)
  actorIdentity Identity? @relation("authenticationSecurityEventActor", fields: [actorIdentityId], references: [id], onDelete: Restrict)
  session AuthenticationSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  @@index([identityId, createdAt])
  @@index([actorIdentityId, createdAt])
  @@index([sessionId, createdAt])
}

model Player {
  id String @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  passport PlayerPassport?
  privateIdentity PlayerPrivateIdentity?
  initialTutorResponsibility InitialTutorResponsibility?
}

model PlayerPrivateIdentity {
  id String @id @default(uuid()) @db.Uuid
  playerId String @unique @db.Uuid
  encryptedLegalName String
  encryptedDateOfBirth String
  encryptedDocumentType String
  encryptedDocumentNumber String
  documentFingerprint String @unique
  nameDobFingerprint String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  player Player @relation(fields: [playerId], references: [id], onDelete: Restrict)
  @@index([nameDobFingerprint])
}

model PlayerPassport {
  id String @id @default(uuid()) @db.Uuid
  playerId String @unique @db.Uuid
  state PassportLifecycleState @default(DRAFT)
  originKind PassportOrigin
  position String
  ageCategory String
  city String
  country String
  dominantFoot DominantFoot
  createdByIdentityId String @db.Uuid
  originAcademyId String? @db.Uuid
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  player Player @relation(fields: [playerId], references: [id], onDelete: Restrict)
  creator Identity @relation("passportCreator", fields: [createdByIdentityId], references: [id], onDelete: Restrict)
  originAcademy Academy? @relation("passportOriginAcademy", fields: [originAcademyId], references: [id], onDelete: Restrict)
  responsibilities PassportResponsibility[]
  reviewReturns PassportReviewReturn[]
  possibleDuplicateSignals PassportPossibleDuplicateSignal[]
  lifecycleEvents PassportLifecycleEvent[]
  @@index([createdByIdentityId, state])
  @@index([originAcademyId])
  @@index([state])
}

model PassportResponsibility {
  id String @id @default(uuid()) @db.Uuid
  passportId String @db.Uuid
  identityId String? @db.Uuid
  academyId String? @db.Uuid
  kind PassportResponsibilityKind
  createdAt DateTime @default(now())
  passport PlayerPassport @relation(fields: [passportId], references: [id], onDelete: Restrict)
  identity Identity? @relation("passportResponsibilityIdentity", fields: [identityId], references: [id], onDelete: Restrict)
  academy Academy? @relation(fields: [academyId], references: [id], onDelete: Restrict)
  @@unique([passportId, kind, identityId])
  @@index([identityId, kind])
  @@index([academyId, kind])
}

model RepresentativeConfirmation {
  id String @id @default(uuid()) @db.Uuid
  passportId String? @db.Uuid
  representativeIdentityId String @db.Uuid
  encryptedLegalName String
  encryptedDocumentType String
  encryptedDocumentNumber String
  encryptedRelationship String?
  documentFingerprint String
  playerDocumentBinding String
  status RepresentativeConfirmationStatus @default(PENDING)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  representative Identity @relation("representativeConfirmationIdentity", fields: [representativeIdentityId], references: [id], onDelete: Restrict)
  @@index([representativeIdentityId, status, expiresAt])
  @@index([playerDocumentBinding, status])
}

model HistoricalTutorReconciliationAudit {
  id String @id @default(uuid()) @db.Uuid
  actorIdentityId String @db.Uuid
  legacyResponsibilityId String?
  outcome String
  reasonCategory String
  createdAt DateTime @default(now())
  actor Identity @relation("reconciliationAuditActor", fields: [actorIdentityId], references: [id], onDelete: Restrict)
  @@index([actorIdentityId, createdAt])
}

model InitialTutorResponsibility {
  id String @id @default(uuid()) @db.Uuid
  playerId String @unique @db.Uuid
  tutorIdentityId String @db.Uuid
  createdAt DateTime @default(now())
  player Player @relation(fields: [playerId], references: [id], onDelete: Restrict)
  tutor Identity @relation("passportResponsibleTutor", fields: [tutorIdentityId], references: [id], onDelete: Restrict)
  @@index([tutorIdentityId])
}

model PassportReviewReturn {
  id String @id @default(uuid()) @db.Uuid
  passportId String @db.Uuid
  analystIdentityId String @db.Uuid
  reason String
  createdAt DateTime @default(now())
  passport PlayerPassport @relation(fields: [passportId], references: [id], onDelete: Restrict)
  analyst Identity @relation("passportReturningAnalyst", fields: [analystIdentityId], references: [id], onDelete: Restrict)
  @@index([passportId, createdAt])
}

model PassportPossibleDuplicateSignal {
  id String @id @default(uuid()) @db.Uuid
  passportId String @db.Uuid
  status PassportPossibleDuplicateStatus @default(UNRESOLVED)
  resolution PassportDuplicateResolution @default(PENDING_REVIEW)
  resolvedByIdentityId String? @db.Uuid
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  passport PlayerPassport @relation(fields: [passportId], references: [id], onDelete: Restrict)
  resolvedBy Identity? @relation("passportSignalResolver", fields: [resolvedByIdentityId], references: [id], onDelete: Restrict)
  @@index([passportId, status])
}

model PassportLifecycleEvent {
  id String @id @default(uuid()) @db.Uuid
  passportId String @db.Uuid
  action PassportLifecycleAction
  outcome PassportLifecycleOutcome
  actorIdentityId String @db.Uuid
  priorState PassportLifecycleState?
  resultingState PassportLifecycleState?
  details Json?
  createdAt DateTime @default(now())
  passport PlayerPassport @relation(fields: [passportId], references: [id], onDelete: Restrict)
  actor Identity @relation("passportEventActor", fields: [actorIdentityId], references: [id], onDelete: Restrict)
  @@index([passportId, createdAt])
  @@index([actorIdentityId, createdAt])
}
