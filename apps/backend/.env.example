# Runtime mode. No implicit default is used.
NODE_ENV=__REQUIRED__
# Local HTTP listener port. This value is not secret.
PORT=__REQUIRED__
# Sensitive PostgreSQL connection URL. Never expose or log this value.
DATABASE_URL=__REQUIRED__
# Explicit comma-delimited HTTP(S) origins. Wildcards are rejected.
ALLOWED_ORIGINS=__REQUIRED__
# Token verification values. Use deployment-provided values; placeholders are rejected at startup.
JWT_ISSUER=__REQUIRED__
JWT_AUDIENCE=__REQUIRED__
# Sensitive HS256 signing secret. Never commit, expose, or log a usable value.
JWT_SIGNING_SECRET=__REQUIRED__
# Approved security policy values. These exact values are validated fail-closed.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_TEMPORARY_CREDENTIAL_TTL_SECONDS=86400
AUTH_ATTEMPT_LIMIT=5
AUTH_ATTEMPT_WINDOW_SECONDS=900
AUTH_TRUSTED_PROXY=false
AUTH_SESSION_RETENTION_DAYS=90
AUTH_ATTEMPT_RETENTION_HOURS=24
# Feature 005 passport keys. Each is a required, non-placeholder base64-encoded 32-byte key.
PASSPORT_DOCUMENT_HMAC_KEY=__REQUIRED__
PASSPORT_NAME_DOB_HMAC_KEY=__REQUIRED__
PASSPORT_PRIVATE_ENCRYPTION_KEY=__REQUIRED__
# Feature 006 private evidence and bounded recovery. Production requires provider=s3 plus bucket, region and encryption.
REGISTRATION_EVIDENCE_PROVIDER=__REQUIRED__
REGISTRATION_EVIDENCE_PRIVATE_ROOT=__REQUIRED__
REGISTRATION_EVIDENCE_S3_BUCKET=__REQUIRED__
REGISTRATION_EVIDENCE_S3_REGION=__REQUIRED__
REGISTRATION_EVIDENCE_S3_ENCRYPTION=__REQUIRED__
REGISTRATION_EVIDENCE_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
REGISTRATION_EVIDENCE_MAX_ITEM_BYTES=10485760
REGISTRATION_EVIDENCE_MAX_REQUEST_BYTES=41943040
REGISTRATION_SCANNER_HOST=__REQUIRED__
REGISTRATION_SCANNER_PORT=3310
REGISTRATION_SCANNER_TIMEOUT_MS=5000
REGISTRATION_PENDING_SESSION_TTL_SECONDS=86400
REGISTRATION_DELETION_BATCH_SIZE=25
REGISTRATION_DELETION_LEASE_SECONDS=60
REGISTRATION_DELETION_BACKOFF_SECONDS=30
REGISTRATION_DELETION_MAX_ATTEMPTS=5
REGISTRATION_ORPHAN_GRACE_SECONDS=86400
